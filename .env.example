# Metron (https://metron.cloud) — optional.
# Sign up at metron.cloud/accounts/signup/, then copy this file to `.env`.
# Despite the documentation describing HTTP basic auth, the API authenticates
# with `Authorization: Bearer <token>`.
#
# Metron blocks an IP at the TCP level for bursty traffic, so the client
# serialises requests and caches answers for 30 days. Do not remove that.
METRON_TOKEN=

# Where Inkwell pushes "your book arrived" and "the download queue has stopped".
# Optional: without it those events are still recorded and shown on My requests,
# they just are not pushed anywhere. Any URL that accepts a POST works — an ntfy
# topic, a Discord webhook, your own receiver. The shape is guessed from the URL
# (Discord webhooks get {content}, everything else gets ntfy's plain body plus a
# Title header); PANEL_NOTIFY_FORMAT overrides that with ntfy, discord or json.
PANEL_NOTIFY_URL=
PANEL_NOTIFY_FORMAT=auto

# Inkwell reaches Komga on the LAN. If readers come through a proxy, the "Read"
# links should point at the address their browser can actually reach.
KOMGA_PUBLIC_URL=
