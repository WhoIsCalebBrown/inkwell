# Metron (https://metron.cloud) — optional.
# Sign up at metron.cloud/accounts/signup/, then copy this file to `.env`.
# Despite the documentation describing HTTP basic auth, the API authenticates
# with `Authorization: Bearer <token>`.
#
# Metron blocks an IP at the TCP level for bursty traffic, so the client
# serialises requests and caches answers for 30 days. Do not remove that.
METRON_TOKEN=
