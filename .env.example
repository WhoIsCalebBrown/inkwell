# Copy to .env and set what applies to your machine. Inkwell can boot without
# integrations, but Mylar plus a ComicVine key are needed for useful requests
# and first-run discovery.

# ── Mylar ────────────────────────────────────────────────────────────────────
# Normal integration: the directory holding Mylar's config.ini and mylar.db — mounted
# read-only. Inkwell reads both API keys from config.ini, so they never enter
# this project, and reads search/queue state from mylar.db, which Mylar's API
# does not expose.
MYLAR_DIR=/path/to/mylar3/mylar

# Mylar's API, including the trailing /api. For a separate Docker container,
# use its service name, not 127.0.0.1 (for example http://mylar:8090/api).
MYLAR_URL=

# Advanced alternative when Mylar appdata cannot be mounted. Leave these blank
# when MYLAR_DIR is set; never commit a populated .env file.
MYLAR_API_KEY=
COMICVINE_API_KEY=
# Optional Mylar browser URL when it differs from MYLAR_URL without /api.
MYLAR_WEB_URL=

# ── Komga ────────────────────────────────────────────────────────────────────
# Optional, and the only way Inkwell can tell "requested" from "on your shelf".
# Without it every title reads as still searching.
KOMGA_URL=

# Either point KOMF_CONFIG at Komf's application.yml, which already holds the
# Komga login…
KOMF_CONFIG=
# …or set the login here instead.
KOMGA_USER=
KOMGA_PASSWORD=

# Where a reader's browser can reach Komga, if that differs from the address
# above. The "Read" links point here.
KOMGA_PUBLIC_URL=

# ── Release image ────────────────────────────────────────────────────────────
# Which published image docker-compose.yml deploys. Blank tracks `latest`, the
# newest stable release. Pin an exact version (for example 1.2.3) to decide for
# yourself when to upgrade; a prerelease only ever publishes its own exact tag.
INKWELL_VERSION=

# ── Container ownership and LAN access ───────────────────────────────────────
# The entrypoint creates/chowns /config, then runs Node as these IDs. Unraid
# commonly uses 99:100; ordinary Docker hosts often use 1000:1000.
PUID=1000
PGID=1000
UMASK=002

# Defaults to 0.0.0.0:3013 for a trusted LAN. HTTPS belongs at your reverse
# proxy/Tailscale/tunnel, not in Inkwell. Set INKWELL_BIND=127.0.0.1 only for a
# same-host proxy topology.
INKWELL_BIND=
INKWELL_PORT=

# Optional Unraid-only Docker-page icon. A local Unraid host path or HTTPS URL.
INKWELL_UNRAID_ICON=

# Optional shared HTTP Basic authentication. Inkwell is a single-user/trusted
# LAN app: there is no public registration or per-user account system in v1.
# Use this and/or authenticated reverse-proxy access outside a trusted LAN.
INKWELL_USER=
INKWELL_PASSWORD=

# Leave empty unless a reverse proxy directly connects to Inkwell and a future
# deployment setting requires trusted forwarded headers. Comma-separated IPs
# or CIDRs only; Inkwell never trusts forwarded headers by default.
INKWELL_TRUSTED_PROXIES=

# ── Notifications ────────────────────────────────────────────────────────────
# Optional. Any URL that accepts a POST: an ntfy topic, a Discord webhook, your
# own receiver. Without one, arrivals and stalls are still recorded and shown
# on the requests page; they are just not pushed anywhere. The shape is guessed
# from the URL — override with ntfy, discord or json.
INKWELL_NOTIFY_URL=
INKWELL_NOTIFY_FORMAT=auto

# ── Optional extras ──────────────────────────────────────────────────────────
# metron.cloud — a community comic database with better story arcs than
# ComicVine. Auth is a bearer token despite the docs describing basic auth.
METRON_TOKEN=

# Existing installations only: set this to the current Docker volume name
# before upgrading, so Compose reuses the database/covers instead of creating
# an empty `inkwell-config` volume.
INKWELL_VOLUME=
