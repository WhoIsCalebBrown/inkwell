# Copy to .env and set what applies to your machine. Nothing here is required
# for the app to boot; the parts you leave empty simply switch features off.

# ── Mylar ────────────────────────────────────────────────────────────────────
# Required. The directory holding Mylar's config.ini and mylar.db — mounted
# read-only. Inkwell reads both API keys from config.ini, so they never enter
# this project, and reads search/queue state from mylar.db, which Mylar's API
# does not expose.
MYLAR_DIR=/path/to/mylar3/mylar

# Mylar's API, including the trailing /api. Default: http://127.0.0.1:8090/api
MYLAR_URL=

# ── Komga ────────────────────────────────────────────────────────────────────
# Optional, and the only way Inkwell can tell "requested" from "on your shelf".
# Without it every title reads as still searching.
KOMGA_URL=

# Either point KOMF_CONFIG at Komf's application.yml, which already holds the
# Komga login…
KOMF_CONFIG=
# …or set the login here instead.
KOMGA_USER=
KOMGA_PASSWORD=

# Where a reader's browser can reach Komga, if that differs from the address
# above. The "Read" links point here.
KOMGA_PUBLIC_URL=

# ── Where Inkwell listens ────────────────────────────────────────────────────
# Defaults to 127.0.0.1:3013. Read the security note in the README before
# binding this to an address other people can reach.
INKWELL_BIND=
INKWELL_PORT=

# Set both to put Inkwell behind a password (HTTP basic auth). Strongly
# recommended if INKWELL_BIND is anything but localhost.
INKWELL_USER=
INKWELL_PASSWORD=

# ── Notifications ────────────────────────────────────────────────────────────
# Optional. Any URL that accepts a POST: an ntfy topic, a Discord webhook, your
# own receiver. Without one, arrivals and stalls are still recorded and shown
# on the requests page; they are just not pushed anywhere. The shape is guessed
# from the URL — override with ntfy, discord or json.
INKWELL_NOTIFY_URL=
INKWELL_NOTIFY_FORMAT=auto

# ── Optional extras ──────────────────────────────────────────────────────────
# metron.cloud — a community comic database with better story arcs than
# ComicVine. Auth is a bearer token despite the docs describing basic auth.
METRON_TOKEN=

# An existing installation's Docker volume, if it is not named inkwell-cache.
INKWELL_VOLUME=
